# ==============================================================================
# RESOLVEGRAPH — STAGING / PRE-PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.staging in pre-production staging environments.
# ==============================================================================

# 1. APPLICATION & SERVER
NODE_ENV=staging
NEXT_PUBLIC_APP_URL=https://staging.resolvegraph.com
PORT=3000

# 2. MANAGED POSTGRESQL DATABASE (Staging Cluster)
DATABASE_URL=postgresql://staging_user:STAGING_DB_PASSWORD@staging-db.resolvegraph.internal:5432/resolvegraph_staging?sslmode=require&connection_limit=15
DIRECT_URL=postgresql://staging_user:STAGING_DB_PASSWORD@staging-db.resolvegraph.internal:5432/resolvegraph_staging?sslmode=require

# 3. AUTHENTICATION & SECRETS (Better Auth)
BETTER_AUTH_SECRET=STAGING_RANDOM_SECRET_KEY_MINIMUM_48_CHARS_REPLACE_ME
BETTER_AUTH_URL=https://staging.resolvegraph.com
ADMIN_BOOTSTRAP_SECRET=STAGING_BOOTSTRAP_SECRET_REPLACE_ME

# 4. EVIDENCE STORAGE (S3-Compatible Staging Bucket)
EVIDENCE_STORAGE_DRIVER=s3
EVIDENCE_S3_BUCKET=resolvegraph-staging-evidence-vault
EVIDENCE_S3_REGION=us-east-1
EVIDENCE_S3_ACCESS_KEY_ID=AKIA_STAGING_KEY_REPLACE_ME
EVIDENCE_S3_SECRET_ACCESS_KEY=SEC_STAGING_SECRET_REPLACE_ME
EVIDENCE_MAX_FILE_BYTES=10485760 # 10 MB

# 5. PAYPAL SANDBOX (Strictly Sandbox in Staging)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=STAGING_PAYPAL_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=STAGING_PAYPAL_SANDBOX_SECRET
PAYPAL_WEBHOOK_ID=STAGING_PAYPAL_WEBHOOK_ID
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=STAGING_PAYPAL_SANDBOX_CLIENT_ID
PAYPAL_LIVE_ENABLED=false
PAYPAL_DISPUTES_ENABLED=true
PAYPAL_WEBHOOK_PROCESSING_ENABLED=true

# 6. AI ENGINE & BERR REASONING
AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj-staging-openai-key-replace-me
OPENAI_MODEL=gpt-4o-mini
AI_PROCESSING_ENABLED=true

# 7. FEATURE FLAGS
FEATURE_AI_ANALYSIS=true
FEATURE_AGENT_COPILOT=true
FEATURE_GRAPH_EXPLORER=true
FEATURE_PAYPAL_SANDBOX=true
FEATURE_PAYPAL_LIVE=false
FEATURE_MERCHANT_PILOT=true
FEATURE_ADVANCED_ANALYTICS=true

# 8. OBSERVABILITY & LOGGING
LOG_LEVEL=info
SENTRY_DSN=https://stagingPublicKey@o0.ingest.sentry.io/0
