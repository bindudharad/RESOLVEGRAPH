# ==============================================================================
# RESOLVEGRAPH — LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local or .env for local development.
# ==============================================================================

# 1. APPLICATION & SERVER
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# 2. LOCAL DATABASE (SQLite with Better-SQLite3 adapter)
DATABASE_URL="file:./dev.db"

# 3. AUTHENTICATION & SECRETS (Better Auth)
BETTER_AUTH_SECRET="dev-insecure-secret-key-minimum-32-characters-for-testing"
BETTER_AUTH_URL="http://localhost:3000"
ADMIN_BOOTSTRAP_SECRET="dev-bootstrap-admin-secret"

# 4. EVIDENCE STORAGE (Local private filesystem storage)
EVIDENCE_STORAGE_DIR="./.private/evidence"
EVIDENCE_MAX_FILE_BYTES=10485760 # 10 MB

# 5. PAYPAL SANDBOX (Sandbox credentials only)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=sb_client_id_placeholder
PAYPAL_CLIENT_SECRET=sb_client_secret_placeholder
PAYPAL_WEBHOOK_ID=sb_webhook_id_placeholder
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=sb
PAYPAL_LIVE_ENABLED=false
PAYPAL_DISPUTES_ENABLED=true
PAYPAL_WEBHOOK_PROCESSING_ENABLED=true

# 6. AI ENGINE & BERR REASONING
AI_PROVIDER=test # "test" (deterministic mock) or "openai"
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-4o-mini
AI_PROCESSING_ENABLED=false

# 7. FEATURE FLAGS
FEATURE_AI_ANALYSIS=true
FEATURE_AGENT_COPILOT=true
FEATURE_GRAPH_EXPLORER=true
FEATURE_PAYPAL_SANDBOX=true
FEATURE_PAYPAL_LIVE=false
FEATURE_MERCHANT_PILOT=true
FEATURE_ADVANCED_ANALYTICS=true

# 8. LOGGING & OBSERVABILITY
LOG_LEVEL=debug
