# ==============================================================================
# RESOLVEGRAPH — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure for your local or production environment.
# Never commit real credentials to source control.
# ==============================================================================

# Database Configuration
# Local SQLite development default:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL (Neon / AWS RDS / Supabase):
# DATABASE_URL="postgresql://user:password@host:5432/resolvegraph?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://user:password@host:5432/resolvegraph?sslmode=require"

NODE_ENV="development"
PORT=3000

# Better-Auth Session & Security
# Generate 32+ character random string in production (e.g. `openssl rand -hex 32`)
BETTER_AUTH_SECRET="change-this-to-a-secure-random-secret-key-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Evidence Vault Storage
EVIDENCE_STORAGE_DIR="./.private/evidence"
# Optional S3-Compatible Cloud Storage (AWS S3 or Cloudflare R2)
# S3_BUCKET_NAME="resolvegraph-vault"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""

# Administrative Security & Kill-Switch
ADMIN_BOOTSTRAP_SECRET="change-this-bootstrap-secret-in-production"
ADMIN_MASTER_SECRET="Admin@ResolveGraph2026!"

# PayPal Sandbox Configuration
PAYPAL_ENV="sandbox" # "sandbox" or "live"
PAYPAL_CLIENT_ID="sb_client_id_placeholder"
PAYPAL_CLIENT_SECRET="sb_client_secret_placeholder"
PAYPAL_WEBHOOK_ID="sb_webhook_id_placeholder"
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
NEXT_PUBLIC_PAYPAL_CLIENT_ID="sb"
PAYPAL_LIVE_ENABLED="false" # CRITICAL: Live financial execution strictly blocked
PAYPAL_DISPUTES_ENABLED="true"
PAYPAL_WEBHOOK_PROCESSING_ENABLED="true"

# Multimodal AI & BERR Intelligence
AI_PROVIDER="openai" # "openai" or "test" (offline deterministic rule engine)
OPENAI_API_KEY="" # Leave empty for offline deterministic fallback
OPENAI_MODEL="gpt-4o-mini"
AI_PROCESSING_ENABLED="false"

# Optional Email / Notification Dispatch
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="notifications@resolvegraph.com"
# SMTP_PASS="secret"
# SMTP_FROM="ResolveGraph <noreply@resolvegraph.com>"
