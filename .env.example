# ResolveGraph Environment Template
DATABASE_URL="file:./dev.db"
NODE_ENV="development"

# Better Auth Configuration (generate 32+ character random string for production)
BETTER_AUTH_SECRET="change-this-to-a-secure-random-secret-key-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Private Evidence File Storage
EVIDENCE_STORAGE_DIR="./.private/evidence"

# Administrator Bootstrap Secret (for one-time initial platform admin setup)
ADMIN_BOOTSTRAP_SECRET="change-this-bootstrap-secret-in-production"

# Optional Email/SMTP Configuration (for password reset and email verification)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="notifications@resolvegraph.com"
# SMTP_PASS="secret"
# SMTP_FROM="ResolveGraph <noreply@resolvegraph.com>"

# Optional Malware Scanner Configuration (e.g. ClamAV TCP daemon)
# CLAMAV_HOST="localhost"
# CLAMAV_PORT="3310"

# Multimodal AI & BERR Intelligence Configuration
AI_PROVIDER="openai" # openai | test
OPENAI_API_KEY="sk-..." # Server-only secret key (never exposed to client)
OPENAI_MODEL="gpt-4o-mini" # Recommended vision-capable model: gpt-4o-mini or gpt-4o
AI_PROCESSING_ENABLED="false" # Explicit toggle for external AI dispatch

# PayPal Sandbox Configuration (Step 6)
# Server-side only credentials (never exposed to client browser bundles)
PAYPAL_ENV="sandbox" # sandbox | live
PAYPAL_CLIENT_ID="sb_client_id_placeholder"
PAYPAL_CLIENT_SECRET="sb_client_secret_placeholder"
PAYPAL_WEBHOOK_ID="sb_webhook_id_placeholder"
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
NEXT_PUBLIC_PAYPAL_CLIENT_ID="sb"
PAYPAL_LIVE_ENABLED="false" # Hard safety guard: live financial transactions strictly blocked
PAYPAL_DISPUTES_ENABLED="true" # Enable Disputes API sandbox synchronization
PAYPAL_WEBHOOK_PROCESSING_ENABLED="true" # Enable processing of incoming PayPal webhook events
