# ==============================================================================
# RESOLVEGRAPH — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.production and provide production credentials.
# NEVER commit production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & NETWORK
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://resolvegraph.com
PORT=3000

# ------------------------------------------------------------------------------
# 2. MANAGED POSTGRESQL DATABASE (Neon / Supabase / AWS RDS)
# ------------------------------------------------------------------------------
# Pooled connection string (e.g., PgBouncer / Neon connection pooler)
DATABASE_URL=postgresql://resolvegraph_user:P4ssw0rd_Secure_Key@ep-resolvegraph-pooler.us-east-1.aws.neon.tech/resolvegraph_prod?sslmode=require&pgbouncer=true&connection_limit=20

# Direct connection string for Prisma schema migrations (non-pooled)
DIRECT_URL=postgresql://resolvegraph_user:P4ssw0rd_Secure_Key@ep-resolvegraph.us-east-1.aws.neon.tech/resolvegraph_prod?sslmode=require

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECRETS (Better Auth)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=SECURE_RANDOM_BASE64_TOKEN_MINIMUM_48_CHARS_REPLACE_ME_NOW
BETTER_AUTH_URL=https://resolvegraph.com
BETTER_AUTH_TRUSTED_ORIGINS=https://resolvegraph.com,https://api.resolvegraph.com
SESSION_MAX_AGE_SECONDS=604800 # 7 days
SESSION_UPDATE_AGE_SECONDS=86400 # 24 hours

# ------------------------------------------------------------------------------
# 4. SECURE PRIVATE EVIDENCE STORAGE (AWS S3 / Cloudflare R2 / MinIO)
# ------------------------------------------------------------------------------
EVIDENCE_STORAGE_DRIVER=s3
EVIDENCE_S3_BUCKET=resolvegraph-production-evidence-vault
EVIDENCE_S3_REGION=us-east-1
EVIDENCE_S3_ACCESS_KEY_ID=AKIA_PROD_EVIDENCE_KEY_REPLACE_ME
EVIDENCE_S3_SECRET_ACCESS_KEY=SEC_PROD_EVIDENCE_SECRET_REPLACE_ME
# Optional S3-compatible custom endpoint (e.g. Cloudflare R2, MinIO)
EVIDENCE_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
EVIDENCE_S3_FORCE_PATH_STYLE=false
EVIDENCE_MAX_FILE_BYTES=10485760 # 10 Megabytes

# ------------------------------------------------------------------------------
# 5. PAYPAL FINTECH INTEGRATION & DISPUTE API
# ------------------------------------------------------------------------------
# Sandbox vs Live Environment
# IMPORTANT: Live payments are hard-blocked unless PAYPAL_LIVE_ENABLED=true
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_LIVE_ENABLED=false

# PayPal Sandbox Credentials (from developer.paypal.com)
PAYPAL_CLIENT_ID=AXXXXXXXXXXXXX_YOUR_PAYPAL_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=EXXXXXXXXXXXXX_YOUR_PAYPAL_SANDBOX_SECRET

# PayPal Webhook ID (obtained from PayPal Developer Dashboard webhook configuration)
PAYPAL_WEBHOOK_ID=WH-XXXXXXXXXXXXX-SANDBOX

# PayPal Partner / Merchant Referencing
PAYPAL_MERCHANT_ID=PARTNER_MERCHANT_ID_OPTIONAL

# ------------------------------------------------------------------------------
# 6. MULTIMODAL AI & BERR REASONING ENGINE
# ------------------------------------------------------------------------------
# AI Provider: "openai" | "test"
AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj-prod_openai_api_key_replace_me
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 7. OBSERVABILITY, AUDIT & LOGGING
# ------------------------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ------------------------------------------------------------------------------
# 8. RATE LIMITING & UPSTASH REDIS (Optional for distributed queue)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://resolvegraph-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=UPSTASH_REST_TOKEN_REPLACE_ME
