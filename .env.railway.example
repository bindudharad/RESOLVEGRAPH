# ==============================================================================
# RESOLVEGRAPH — RAILWAY DEMONSTRATION DEPLOYMENT ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy and paste these variables into the Railway Dashboard (Variables tab).
# Sensitive secrets must be generated with strong random values.
# ==============================================================================

# 1. CORE NETWORK & APPLICATION URL
NODE_ENV=production
HOSTNAME=0.0.0.0
# Railway provides ${{RAILWAY_PUBLIC_DOMAIN}} automatically once domain is generated.
NEXT_PUBLIC_APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
BETTER_AUTH_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
BETTER_AUTH_TRUSTED_ORIGINS=https://${{RAILWAY_PUBLIC_DOMAIN}}

# 2. PERSISTENT VOLUME STORAGE (Mount volume at /data)
DATABASE_URL="file:/data/resolvegraph.db"
EVIDENCE_STORAGE_PATH="/data/evidence"
EVIDENCE_STORAGE_DIR="/data/evidence"

# 3. AUTHENTICATION & DEMO ACCESS GATES
# Generate a 32+ character random secret (e.g. `openssl rand -hex 32`)
BETTER_AUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_HEX_32_GENERATED_SECRET"
# Set to "true" to enable 1-click synthetic demo logins on /sign-in in production
RESOLVEGRAPH_DEMO_ACCESS="true"
ADMIN_MASTER_SECRET="Admin@ResolveGraph2026!"
ADMIN_BOOTSTRAP_SECRET="REPLACE_WITH_RANDOM_ADMIN_BOOTSTRAP_SECRET_MIN_32"

# 4. FINTECH SAFEGUARDS & SANDBOX MOCKS (Live operations hard-blocked)
PAYPAL_ENV="sandbox"
PAYPAL_LIVE_ENABLED="false"
PAYPAL_CLIENT_ID="sb_client_id_demo_placeholder"
PAYPAL_CLIENT_SECRET="sb_client_secret_demo_placeholder"
PAYPAL_WEBHOOK_ID="sb_webhook_id_demo_placeholder"
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
NEXT_PUBLIC_PAYPAL_CLIENT_ID="sb"
PAYPAL_DISPUTES_ENABLED="true"
PAYPAL_WEBHOOK_PROCESSING_ENABLED="true"

# 5. MULTIMODAL AI & BERR REASONING ENGINE
# Use "test" for deterministic offline BERR v2.0 reasoning (fastest, no paid API keys required)
AI_PROVIDER="test"
AI_PROCESSING_ENABLED="false"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Optional Google Gemini (Server-Side Only - never expose to browser)
GEMINI_API_KEY=""
GEMINI_VISION_MODEL="gemini-3.6-flash"
GEMINI_VIDEO_MODEL="gemini-3.6-flash"
GEMINI_FREE_TIER_ONLY="true"
